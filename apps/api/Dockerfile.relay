FROM node:22-bookworm-slim

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
      ca-certificates \
      ffmpeg \
      fonts-liberation \
      libasound2 \
      libatk-bridge2.0-0 \
      libatk1.0-0 \
      libc6 \
      libcairo2 \
      libcups2 \
      libdbus-1-3 \
      libdrm2 \
      libgbm1 \
      libglib2.0-0 \
      libgtk-3-0 \
      libnspr4 \
      libnss3 \
      libpango-1.0-0 \
      libx11-6 \
      libx11-xcb1 \
      libxcb1 \
      libxcomposite1 \
      libxdamage1 \
      libxext6 \
      libxfixes3 \
      libxkbcommon0 \
      libxrandr2 \
      unzip \
      xauth \
      xdg-utils \
      xvfb \
    && rm -rf /var/lib/apt/lists/*

RUN corepack enable && npm install --global tsx

WORKDIR /app

COPY package.json yarn.lock ./
RUN yarn install --frozen-lockfile
ENV PUPPETEER_CACHE_DIR=/app/.cache/puppeteer
RUN npx puppeteer browsers install chrome

COPY . .
RUN mkdir -p /app/dist/src/public
COPY relay-entrypoint.sh /usr/local/bin/relay-entrypoint.sh
RUN chmod +x /usr/local/bin/relay-entrypoint.sh

ENV BROWSER_OUTPUT_DIR=/app/dist/src/public
ENV PUPPETEER_NO_SANDBOX=true

CMD ["/usr/local/bin/relay-entrypoint.sh"]
